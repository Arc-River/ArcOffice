{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**/*.ts", "src/**/*.vue", "*.ts"],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useVueMultiWordComponentNames": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/src/components/onlyoffice/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noImplicitAnyLet": "off",
            "noRedeclare": "off",
            "useIterableCallbackReturn": "off",
            "noAssignInExpressions": "off"
          },
          "correctness": {
            "noInnerDeclarations": "off"
          },
          "complexity": {
            "noBannedTypes": "off",
            "noCommaOperator": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          },
          "security": {
            "noGlobalEval": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
